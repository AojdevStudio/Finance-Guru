{
    "version": "1.0",
    "description": "Skill activation triggers for Claude Code. Controls when skills automatically suggest or block actions.",
    "skills": {
        "portfolio-syncing": {
            "type": "domain",
            "enforcement": "block",
            "priority": "critical",
            "description": "Refresh SnapTrade positions and balances into family_office.db, then validate the snapshot. USE WHEN user mentions sync portfolio OR update positions OR refresh positions OR portfolio-sync. Handles position updates, SPAXX/margin validation, and safety checks.",
            "promptTriggers": {
                "keywords": [
                    "import fidelity",
                    "fidelity csv",
                    "sync portfolio",
                    "update positions",
                    "portfolio import",
                    "csv import",
                    "portfolio sync",
                    "portfolio-sync",
                    "fidelity export",
                    "import csv",
                    "sync positions"
                ],
                "intentPatterns": [
                    "(import|update|sync|load).*?(fidelity|portfolio|positions|csv)",
                    "new.*?(fidelity csv|portfolio export)",
                    "(update|refresh).*?(portfolio|positions).*?(fidelity|csv)",
                    "(import|sync).*?(portfolio_positions|positions csv)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "notebooks/updates/DataHub_*.csv",
                    "notebooks/updates/Balances_for_Account_*.csv"
                ],
                "contentPatterns": [
                    "Symbol,Quantity",
                    "Average Cost Basis",
                    "DataHub",
                    "Account Number,Account Name,Symbol"
                ]
            }
        },
        "dividend-tracking": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Sync dividend portfolio data between Portfolio Positions and Dividend Tracker. Cross-references Layer 2 holdings, updates shares, calculates income.",
            "promptTriggers": {
                "keywords": [
                    "dividend tracker",
                    "sync dividends",
                    "update dividends",
                    "dividend income",
                    "layer 2 income",
                    "dividend portfolio",
                    "drip status",
                    "dividend payments",
                    "expected dividends",
                    "monthly income"
                ],
                "intentPatterns": [
                    "(sync|update|refresh).*?(dividend tracker|dividends)",
                    "(calculate|check).*?(dividend income|expected dividends)",
                    "update.*?(layer 2|income portfolio)",
                    "(add|track).*?(dividend fund|income fund)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "fin-guru/data/*dividend*.md",
                    "fin-guru-private/fin-guru/strategies/active/*dividend*.md",
                    "fin-guru/data/user-profile.yaml"
                ]
            }
        },
        "margin-management": {
            "type": "domain",
            "enforcement": "block",
            "priority": "critical",
            "description": "Update Margin Dashboard with Fidelity balances. Calculates margin metrics, coverage ratios, safety thresholds, and provides scaling recommendations.",
            "promptTriggers": {
                "keywords": [
                    "margin dashboard",
                    "update margin",
                    "margin balance",
                    "margin strategy",
                    "margin living",
                    "coverage ratio",
                    "margin scaling",
                    "margin interest",
                    "portfolio to margin ratio",
                    "margin draw"
                ],
                "intentPatterns": [
                    "(update|sync|check).*?(margin|margin balance|margin dashboard)",
                    "(calculate|check).*?(coverage ratio|margin interest)",
                    "margin.*?(strategy|scaling|alert|threshold)",
                    "update.*?(balances|fidelity balances)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "notebooks/updates/Balances_for_Account_*.csv",
                    "fin-guru/data/*margin*.md",
                    "fin-guru-private/fin-guru/strategies/active/*margin*.md"
                ]
            }
        },
        "retirement-syncing": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Parse and report retirement account holdings from Vanguard and Fidelity CSV exports. Aggregates holdings by ticker. No persistent destination until these accounts are connected in SnapTrade.",
            "promptTriggers": {
                "keywords": [
                    "sync retirement",
                    "update retirement",
                    "retirement accounts",
                    "vanguard sync",
                    "401k update",
                    "ira sync",
                    "retirement quantities",
                    "retirement positions",
                    "vanguard ira",
                    "fidelity 401k"
                ],
                "intentPatterns": [
                    "(sync|update|refresh).*?(retirement|vanguard|401k|ira)",
                    "(import|load).*?(retirement|vanguard csv|401k)",
                    "update.*?(retirement accounts|retirement quantities)",
                    "(sync|update).*?(retirement section|retirement holdings)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "notebooks/retirement-accounts/*.csv",
                    "notebooks/retirement-accounts/OfxDownload*.csv",
                    "notebooks/retirement-accounts/Portfolio_Positions_*.csv"
                ]
            }
        },
        "finance-report": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Generate institutional-quality PDF analysis reports for stocks and ETFs. Includes VGT-style headers, embedded charts, portfolio sizing, and Perplexity sentiment integration.",
            "promptTriggers": {
                "keywords": [
                    "generate report",
                    "create pdf",
                    "stock analysis",
                    "ticker report",
                    "watchlist analysis",
                    "analysis report",
                    "investment report",
                    "research report",
                    "regenerate reports",
                    "full analysis"
                ],
                "intentPatterns": [
                    "(generate|create|make|build).*?(report|pdf|analysis)",
                    "(full|thorough|comprehensive|deep).*?(analysis|research)",
                    "(analyze|research).*?(stock|ticker|etf)",
                    "regenerate.*?(batch|reports|watchlist)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "fin-guru-private/fin-guru/analysis/reports/*.pdf",
                    "fin-guru-private/fin-guru/analysis/*watchlist*.md",
                    "scripts/reports/generate_*_report.py"
                ]
            }
        },
        "transaction-syncing": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Refresh investment activities and bank/card expenses into family_office.db with smart categorization. Handles dividends, purchases, sales, fees, and direction resolution for deposits.",
            "promptTriggers": {
                "keywords": [
                    "sync transactions",
                    "import transactions",
                    "transaction history",
                    "fidelity transactions",
                    "transaction import",
                    "update transactions",
                    "transaction sync",
                    "trade history",
                    "purchase history",
                    "dividend history"
                ],
                "intentPatterns": [
                    "(sync|import|update|load).*?(transactions|transaction history)",
                    "(fidelity|brokerage).*?(transactions|trade history)",
                    "(import|sync).*?(purchases|sales|dividends).*?(history|csv)",
                    "(update|refresh).*?(transaction|trade).*?(log|history|sheet)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "notebooks/updates/History_for_Account_*.csv",
                    "notebooks/updates/*transaction*.csv"
                ]
            }
        }
    },
    "notes": {
        "enforcement_types": {
            "suggest": "Skill suggestion appears but doesn't block execution",
            "block": "Requires skill to be used before proceeding (guardrail)",
            "warn": "Shows warning but allows proceeding"
        },
        "priority_levels": {
            "critical": "Highest - Always trigger when matched",
            "high": "Important - Trigger for most matches",
            "medium": "Moderate - Trigger for clear matches",
            "low": "Optional - Trigger only for explicit matches"
        },
        "customization": {
            "pathPatterns": "Adjust to match your project structure (blog-api, auth-service, etc.)",
            "keywords": "Add domain-specific terms relevant to your project",
            "intentPatterns": "Use regex for flexible user intent matching"
        }
    }
}
